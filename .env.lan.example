# LAN-only profile. Do not expose this mode to the public Internet.
# `npm run start:lan -- --origin http://192.168.1.20:3117` sets the runtime flags.
NEXUS_DEPLOYMENT_MODE=lan
NEXUS_ALLOW_DEMO_IDENTITY=true
LAN_STORAGE_MODE=memory
HOSTNAME=0.0.0.0
PORT=3117

# Optional but recommended for CSRF/origin clarity. Replace with the server's
# stable LAN address; do not use 0.0.0.0 as a browser origin.
PUBLIC_APP_ORIGIN=http://192.168.1.20:3117

# For restart-safe task, message and memory facts, prefer a local PostgreSQL
# service and set LAN_STORAGE_MODE=postgres plus DATABASE_URL.
# DATABASE_URL=postgres://nexus:nexus-local-password@127.0.0.1:5432/nexus
