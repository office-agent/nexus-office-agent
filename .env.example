# Configure these through the local encrypted profile manager or your deployment secret store.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
NEXUS_MODEL_MODE=enabled

# Pi Runner / Sandbox. Production requires a Firecracker/Kata Supervisor and a managed
# HMAC secret; the secret is never written to a RunManifest, database record, or model context.
NEXUS_PI_SANDBOX_PROVIDER=firecracker
NEXUS_PI_SANDBOX_ENDPOINT=
NEXUS_PI_SANDBOX_RUN_TOKEN_SECRET=
NEXUS_PI_SANDBOX_ROOTFS=
NEXUS_PI_SANDBOX_KERNEL_IMAGE=
NEXUS_PI_SANDBOX_GUEST_AGENT_PORT=5000
NEXUS_PI_SANDBOX_GUEST_CID=3
NEXUS_PI_FIRECRACKER_PATH=/usr/local/bin/firecracker
NEXUS_PI_EGRESS_PROXY_ENDPOINT=
NEXUS_PI_SANDBOX_SUPERVISOR_BACKEND=firecracker
NEXUS_PI_SANDBOX_STATE_DIR=/var/lib/nexus/pi-sandbox-supervisor
NEXUS_PI_SANDBOX_SOCKET_DIRECTORY=/run/nexus/pi-sandbox
NEXUS_PI_CGROUP_ROOT=/sys/fs/cgroup/nexus-pi
NEXUS_PI_SANDBOX_SUPERVISOR_HOST=0.0.0.0
NEXUS_PI_SANDBOX_SUPERVISOR_PORT=8080

# Core platform
DATABASE_URL=
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=
PUBLIC_APP_ORIGIN=http://localhost:3000

# Enterprise OIDC. Subject mapping keys use "<normalized issuer>::<subject>" and values contain tenantId, actorId, roles, permissions and dataScopes.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
OIDC_STATE_SECRET=
OIDC_SUBJECT_MAP_JSON=

# Local acceptance only. Production defaults to verified identity required; never enable this in a real deployment.
NEXUS_ALLOW_DEMO_IDENTITY=false

# Connector credentials belong in local/deployment secret management only.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CALLBACK_TOKEN=
DINGTALK_ENCODING_AES_KEY=
DINGTALK_RECEIVE_ID=
# 企业微信应用凭据使用独立的 .env.wecom.local；参见 .env.wecom.example。
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=

# Multi-installation deployments should map each connection.secret_ref to a secret object in the deployment secret store.
# The local environment adapter accepts a JSON object for fixture/dev use; keep the real value out of source control.
CONNECTOR_SECRETS_JSON=

# Production secret broker. The resolver accepts opaque secret:// references and never returns values in status APIs.
SECRET_PROVIDER=environment
SECRET_MANAGER_URL=
SECRET_MANAGER_AUTH_TOKEN=

# Production operations gate.
NEXUS_RELEASE_VERSION=0.14.0
REQUIRED_WORKER_ROLES=inbox,agent,outbox
ENABLED_CONNECTORS=
OTEL_EXPORTER_OTLP_ENDPOINT=
WAF_MODE=
RATE_LIMIT_MODE=
AUDIT_RETENTION_DAYS=365
BACKUP_TARGET_URI=
BACKUP_ENCRYPTION_KEY_REF=
RESTORE_DATABASE_URL=
NEXUS_RESTORE_CONFIRM=

# Self-built PWA and device policy. Push public key is public; subscription data encryption key remains a managed secret reference.
CLIENT_MIN_VERSION=0.9.0
CLIENT_MANAGED_DEVICE_REQUIRED=false
CLIENT_OFFLINE_DRAFTS=disabled
CLIENT_PUSH_ENABLED=false
CLIENT_PUSH_PUBLIC_KEY=
CLIENT_DATA_ENCRYPTION_KEY_REF=
