FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./tsconfig.json
COPY src ./src
COPY scripts/pi-sandbox-supervisor.ts scripts/build-pi-sandbox-supervisor.mjs ./scripts/
RUN node scripts/build-pi-sandbox-supervisor.mjs

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    NEXUS_PI_SANDBOX_SUPERVISOR_HOST=0.0.0.0 \
    NEXUS_PI_SANDBOX_SUPERVISOR_PORT=8080 \
    NEXUS_PI_SANDBOX_STATE_DIR=/var/lib/nexus/pi-sandbox-supervisor \
    NEXUS_PI_SANDBOX_SOCKET_DIRECTORY=/run/nexus/pi-sandbox \
    NEXUS_PI_FIRECRACKER_PATH=/usr/local/bin/firecracker
RUN addgroup --system --gid 1001 nexus && adduser --system --uid 1001 --ingroup nexus nexus \
  && mkdir -p /var/lib/nexus/pi-sandbox-supervisor /run/nexus/pi-sandbox \
  && chown -R nexus:nexus /var/lib/nexus /run/nexus
COPY --from=builder --chown=nexus:nexus /app/.pi-runtime/pi-sandbox-supervisor.mjs ./pi-sandbox-supervisor.mjs
USER nexus
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "pi-sandbox-supervisor.mjs"]
